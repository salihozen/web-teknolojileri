            "type": "text/javascript",
            "exec": [
              "pm.test('Durum Kodu 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Öğrenci Numarası Doğru (2416501011)', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.student).to.eql('2416501011');",
              "    pm.expect(jsonData.status).to.eql('ok');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
